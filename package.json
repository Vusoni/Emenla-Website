{
  "name": "emenla-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public website for Emenla. Static HTML, no framework, no third-party requests.",
  "scripts": {
    "assets": "python3 scripts/make-assets.py",
    "build": "echo \"Static site: site/ is already built, nothing to compile.\"",
    "check": "node scripts/check-copy.mjs --strict && node scripts/check-links.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:links": "node scripts/check-links.mjs",
    "serve": "python3 -m http.server 8080 --directory site",
    "build:legacy": "node scripts/build.mjs",
    "prebuild:legacy": "npm run assets",
    "setup:seo": "bash scripts/setup-seo.sh"
  }
}
