# Cloudflare Pages headers. Mirrors site/.htaccess, which only applies on Apache hosts.
# Fingerprint-free filenames live under /assets/, so they are cached hard and replaced by name.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Root images can change without a filename change, so revalidate daily.
/og.png
  Cache-Control: public, max-age=86400
/favicon.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# No Cache-Control here on purpose: Pages already revalidates HTML on every request,
# and a second rule on the same path would fight the ones above.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
